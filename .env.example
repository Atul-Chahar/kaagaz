# Kaagaz configuration. Copy to .env and edit. Every variable is optional.

# FalkorDB connection. docker compose sets these for the app container; for local dev the defaults match
# `docker compose up -d falkordb` (host port 6380).
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
# Only for FalkorDB Cloud or a password-protected server:
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Host ports used by docker compose (change if they clash with something on your machine)
FALKORDB_HOST_PORT=6380
FALKORDB_BROWSER_PORT=3000
KAAGAZ_PORT=8000
# Where the "Open in FalkorDB Browser" link points
FALKORDB_BROWSER_URL=http://localhost:3000
# Seed the rule packs into FalkorDB when the API starts, if they are missing (1 = yes)
KAAGAZ_SEED_ON_START=1
# Per-query timeout in milliseconds (the FalkorDB image default is 1000)
KAAGAZ_QUERY_TIMEOUT_MS=10000

# Optional LLM layer. Leave empty and everything works: the Ask box becomes a name search.
# LLM_PROVIDER: "anthropic" or "openai" (any OpenAI-compatible endpoint: OpenAI, Groq, Gemini's OpenAI-compatible
# API, a local Ollama). Use a model name that your provider lists; Kaagaz does not pick one for you.
LLM_PROVIDER=
# For "openai": the base URL, e.g. https://api.openai.com/v1, https://api.groq.com/openai/v1,
# https://generativelanguage.googleapis.com/v1beta/openai, or http://localhost:11434/v1 for Ollama.
# For "anthropic": leave empty to use https://api.anthropic.com
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
